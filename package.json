{
  "name": "satr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check": "vite build --ssr scripts/check.ts --outDir node_modules/.check --emptyOutDir --logLevel warn && node node_modules/.check/check.js",
    "build:server": "vite build --ssr server/index.ts --outDir dist-server --emptyOutDir --logLevel warn",
    "start": "node dist-server/index.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "motion": "12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
