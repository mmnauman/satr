# Neon Serverless Postgres connection string (enables multi-device Live Application persistence)
# When omitted, Satr automatically uses LocalBrowserCaseAdapter (localStorage + BroadcastChannel).
DATABASE_URL=

# Optional grounded reply synthesis endpoint (receives ONLY already-redacted tool observations)
# Leave blank to use Satr's deterministic bilingual catalog engine.
SATR_SYNTHESIS_URL=
SATR_SYNTHESIS_KEY=
SATR_SYNTHESIS_MODEL=

# Staff sign-in. Counsellors, court clerks and health-system analysts exchange this key for a signed,
# 12-hour token. When unset, the published demo key "satr-demo" works and the sign-in page shows it.
SATR_STAFF_KEY=
# Secret used to sign staff tokens. Set a long random value in any shared deployment.
SATR_SESSION_SECRET=
# Where the server keeps cases when DATABASE_URL is not set (defaults to ./.data).
SATR_DATA_DIR=
